root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
indent_style = tab

[*.{yaml,yml}]
indent_size = 2

[*.xlf]
indent_style = tab

[*.neon]
indent_size = 2
indent_style = tab

[*.{typoscript,tsconfig}]
indent_size = 2
indent_style = tab
