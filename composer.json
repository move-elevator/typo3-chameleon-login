{
	"name": "move-elevator/typo3-chameleon-login",
	"description": "Seasonal background images for the TYPO3 backend login.",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"typo3-extension",
		"backend",
		"login",
		"season"
	],
	"homepage": "https://github.com/move-elevator/typo3-chameleon-login",
	"support": {
		"issues": "https://github.com/move-elevator/typo3-chameleon-login/issues",
		"source": "https://github.com/move-elevator/typo3-chameleon-login"
	},
	"require": {
		"php": "^8.4",
		"symfony/console": "^7.4 || ^8.0",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3"
	},
	"require-dev": {
		"captainhook/captainhook": "^5.29",
		"helhum/typo3-console": "^8.3",
		"phpunit/phpunit": "^13.0",
		"ramsey/conventional-commits": "^1.7",
		"typo3/cms-base-distribution": "^14.3",
		"typo3/cms-scheduler": "^14.3",
		"typo3/testing-framework": "^9.0"
	},
	"suggest": {
		"typo3/cms-scheduler": "Run the chameleon-login:apply command as a scheduled task."
	},
	"autoload": {
		"psr-4": {
			"MoveElevator\\Typo3ChameleonLogin\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MoveElevator\\Typo3ChameleonLogin\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "typo3_chameleon_login"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@cgl install"
		],
		"cgl": "@composer -d Tests/CGL --",
		"test": [
			"@test:unit"
		],
		"test:unit": "phpunit -c Build/phpunit/UnitTests.xml"
	}
}
