includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 8

	typo3:
		requestGetAttributeMapping:
			route: TYPO3\CMS\Backend\Routing\Route|null

	scanDirectories:
		- ../../vendor
	paths:
		- ../../Classes
		- ../../Configuration
